# .env.example
ASSEMBLYAI_API_KEY=
# Shared secret of our own invention. Stored on the agent as llm.api_key and sent
# back to us as `Authorization: Bearer …` on every chat-completions request, so
# /api/llm can tell AssemblyAI apart from a stranger who found the URL.
ALOUD_LLM_SHARED_SECRET=
NEXT_PUBLIC_APP_ORIGIN=
# Optional. Unset, /api/call is open — which is what a judge following a link
# needs. Set it before posting the link anywhere public.
ALOUD_DEMO_CODE=
